<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="gitapp.controller.View1">
    <Page id="page" title="SAP Database Demo">
        <content>
            <VBox class="sapUiSmallMargin">
                <Title text="PostgreSQL Database Connection Demo" level="H2" class="sapUiSmallMarginBottom"/>

                <!-- Connection Status -->
                <ObjectStatus
                    text="Database Status: {dbModel>/connectionStatus}"
                    state="Success"
                    class="sapUiSmallMarginBottom"/>

                <!-- Action Buttons -->
                <HBox class="sapUiSmallMarginBottom">
                    <Button text="Test Connection" press="onTestConnection" type="Emphasized" class="sapUiSmallMarginEnd"/>
                    <Button text="Refresh Data" press="onRefreshData" class="sapUiSmallMarginEnd"/>
                    <Button text="Add Sample Data" press="onAddData" type="Accept"/>
                </HBox>

                <!-- Database Data Table -->
                <Table
                    id="databaseTable"
                    items="{dbModel>/databaseData}"
                    class="sapUiSmallMarginTop"
                    busy="{dbModel>/isLoading}"
                    busyIndicatorDelay="0">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Database Records" level="H3"/>
                            <ToolbarSpacer/>
                            <Text text="{dbModel>/databaseData/length} records"/>
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column>
                            <Text text="ID"/>
                        </Column>
                        <Column>
                            <Text text="Name"/>
                        </Column>
                        <Column width="4rem">
                            <Text text="Actions"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{dbModel>ID}"/>
                                <Text text="{dbModel>Name}"/>
                                <Button
                                    icon="sap-icon://delete"
                                    type="Reject"
                                    press="onDeleteData"
                                    tooltip="Delete this record"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!-- Info Panel -->
                <Panel headerText="Implementation Notes" class="sapUiSmallMarginTop">
                    <content>
                        <Text text="This demo shows a complete SAP UI5 application with PostgreSQL database connectivity:"/>
                        <VBox class="sapUiSmallMarginTop">
                            <Text text="✓ Database service bound in manifest.json"/>
                            <Text text="✓ Node.js backend service with REST API endpoints"/>
                            <Text text="✓ UI5 app calls backend APIs for full CRUD operations"/>
                            <Text text="✓ Real-time data display with loading indicators"/>
                            <Text text="✓ Automatic deployment via CI/CD pipelines"/>
                        </VBox>
                        <Text text="Features: Create, Read, Update, Delete operations with PostgreSQL database" class="sapUiSmallMarginTop"/>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>