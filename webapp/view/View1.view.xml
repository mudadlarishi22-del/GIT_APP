<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" controllerName="gitapp.controller.View1">
    <Page id="page" title="SAP Database Demo">
        <content>
            <VBox class="sapUiSmallMargin">
                <Title text="PostgreSQL Database Connection Demo" level="H2" class="sapUiSmallMarginBottom"/>

                <!-- Connection Status -->
                <ObjectStatus
                    text="Database Status: {dbModel>/connectionStatus}"
                    state="Success"
                    class="sapUiSmallMarginBottom"/>

                <!-- Action Buttons -->
                <HBox class="sapUiSmallMarginBottom">
                    <Button text="Test Connection" press="onTestConnection" type="Emphasized" class="sapUiSmallMarginEnd"/>
                    <Button text="Refresh Data" press="onRefreshData" class="sapUiSmallMarginEnd"/>
                    <Button text="Add Sample Data" press="onAddData" type="Accept"/>
                </HBox>

                <!-- Database Data Table -->
                <Table
                    id="databaseTable"
                    items="{dbModel>/databaseData}"
                    class="sapUiSmallMarginTop">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Database Records" level="H3"/>
                            <ToolbarSpacer/>
                            <Text text="{dbModel>/databaseData/length} records"/>
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column>
                            <Text text="ID"/>
                        </Column>
                        <Column>
                            <Text text="Name"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{dbModel>ID}"/>
                                <Text text="{dbModel>Name}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!-- Info Panel -->
                <Panel headerText="Implementation Notes" class="sapUiSmallMarginTop">
                    <content>
                        <Text text="This demo shows how a SAP UI5 application would connect to a PostgreSQL database:"/>
                        <VBox class="sapUiSmallMarginTop">
                            <Text text="1. Database service is bound in manifest.json"/>
                            <Text text="2. Backend service provides REST API endpoints"/>
                            <Text text="3. UI5 app calls backend APIs for data operations"/>
                            <Text text="4. Data is displayed in SAP UI5 controls"/>
                        </VBox>
                        <Text text="Note: Actual database connection requires a backend service (blocked by trial route quota)" class="sapUiSmallMarginTop"/>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>